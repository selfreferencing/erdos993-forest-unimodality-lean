  interval_cases p

  ·
    refine checked_piece_noValley (p := 0) (D := N21.D21tab 0) (by omega) ht htp
      (by simpa [N21.piece21, Act1.pieceD65, pieceV21, piece44] using MGF.Checks.checkR21S00)
