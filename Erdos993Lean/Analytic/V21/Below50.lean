/-- Paper v2.1 Theorem 5.8(a), exactly the below-50 case: the same Laplace
rows give no valley throughout [m25(iota),50] at the hand-variance cap. -/
theorem below50_noValley {t m : ℝ} (ht : InRange t)
    (hm : ((m25.getD (pieceOf t) 0 : ℚ) : ℝ) ≤ m) (hm' : m ≤ 50) :
    NoValleyAtMGF2 (actQ t) m (P44.θb t) (HandVariance.handCap t)
      (mgfRows (tilts44R t) (actQ t) m) := by
  have hp := (pieceOf_spec ht).1
  rcases le_or_gt (((mstar.getD (pieceOf t) 0 : ℚ) : ℝ)) m with hs | hs
  · have hpos : (0 : ℝ) < ((m25.getD (pieceOf t) 0 : ℚ) : ℝ) := by
      exact_mod_cast m25_pos (pieceOf t) hp
    exact mstar_to50_noValley hp ht rfl hs hm' (by linarith)
  · exact below_mstar_noValley hp ht rfl hm hs.le

