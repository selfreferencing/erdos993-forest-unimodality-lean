/-!
# Paper v2.1 Lemma 5.4 and Theorem 5.8(a): the entire parameter region below 50

Source: the 55-row exact table CHECKS/V21/coverage_table.md and the source
receipts CHECKS/V21/coverage_audit.json. This proof uses the original MGF
criterion on both sides of m*(iota). The checked cap may be larger than the
hand cap; monotonicity retains the actual activity, mean and Laplace rows.
The base and extension checks at subintervals 16 and 18 are consumed by an
explicit mean split. The original q-slab count therefore remains 109.
-/

namespace Erdos993Lean.Analytic.V21

open Erdos993Lean.Analytic.N44
open Erdos993Lean.Analytic.MGF

set_option maxHeartbeats 4000000

/-- Paper v2.1 Theorem 5.8(a): a checked piece at a sufficient cap gives the
same no-valley conclusion at the actual activity's hand cap. -/
private theorem checked_piece_noValley {p : ℕ} {D mlo mhi : ℚ}
    {boxes : List MBox} {slabs : List Atlas.Slab} (hp : p < 55)
    {t : ℝ} (ht : InRange t) (htp : pieceOf t = p)
    (hok : pieceOK { piece44 p with D := D } mlo mhi boxes slabs = true)
    {m : ℝ} (hm0 : 0 ≤ m) (hD : HandVariance.handCap t ≤ (D : ℝ))
    (hm : (mlo : ℝ) ≤ m) (hm' : m ≤ (mhi : ℝ)) :
    NoValleyAtMGF2 (actQ t) m (P44.θb t) (HandVariance.handCap t)
      (mgfRows (tilts44R t) (actQ t) m) := by
  obtain ⟨-, -, hlo, hhi⟩ := pieceOf_spec ht
  rw [htp] at hlo hhi
  unfold loR at hlo
  unfold hiR at hhi
  have ht0 : 0 ≤ t := by have := ht.1; linarith
  have h0 : (0 : ℝ) ≤ ((N44.Data.pieceLo.getD p 0 : ℚ) : ℝ) := by
    exact_mod_cast (pieceLo_pos p hp).le
  have h := pieceOK_noValley hok (q := actQ t) (m := m)
    (Atlas.actQ_le_actQ h0 hlo) (Atlas.actQ_le_actQ ht0 hhi) hm hm'
  have e1 : (((piece44 p).theta : ℚ) : ℝ) = P44.θb t := by
    rw [P44_θb, htp]; rfl
  have e3 : castTilts (piece44 p).tilts = tilts44R t := by
    unfold tilts44R tilts44; rw [htp]; rfl
  change NoValleyAtMGF2 (actQ t) m ((piece44 p).theta : ℝ) (D : ℝ)
    (mgfRows (castTilts (piece44 p).tilts) (actQ t) m) at h
  rw [e1, e3] at h
  exact noValleyAtMGF2_mono hm0
    (mul_nonneg (HardCore.actQ_nonneg ht0) (HardCore.one_sub_actQ_pos ht0).le)
    le_rfl hD h

