/-- Paper v2.1 Lemma 5.4: the 229-box coverings from m*(iota) to 50. -/
theorem mstar_to50_noValley {p : ℕ} (hp : p < 55) {t m : ℝ}
    (ht : InRange t) (htp : pieceOf t = p)
