def cell (index : Nat) : V22SpikeCell :=
  spikeCells.getD index ⟨0, 0, 0, 0, [], [], false⟩
def rm (c : V22SpikeCell) : Rat :=
  match classes.find? (fun k => k.classId == c.classId) with
  | some k => k.rb
  | none => 1 / 4
def m1 (c : V22SpikeCell) (i : Nat) : Rat :=
  (([1, 2, 4, 8, 16] : List Nat).getD i 0 : Rat) * c.ma

def piecePass (c : V22SpikeCell) (i : Nat) (p : RayPiece) : Bool :=
  let lower := m1 c i
  let bound := c.logBounds.getD i 0
  if i = 4 then
    infinitePass p.brackets (spanEnv p.tspan) (Expr.var 0) (Expr.rat lower) lower (rm c) bound
  else
    RayEnvelope.finitePass p.brackets ⟨p.methods, p.firstUniversal, p.secondUniversal⟩
      (spanEnv p.tspan) (Expr.var 0) (Expr.rat lower)
      lower (2 * lower) (rm c) bound

def blockPhiPass (b : RayBlock) : Bool :=
  let c := cell b.cellIndex
  decide (b.cellIndex < 44 ∧ b.blockIndex < 5) &&
  partitionFrom c.lo c.hi (b.pieces.map (·.tspan)) &&
  b.pieces.all (piecePass c b.blockIndex)

/-- Covers only blocks explicitly marked status 0; no assertion about alternatives. -/
def phiCandidatesPass : Bool := (blocks.filter (fun b => b.status == 0)).all blockPhiPass
/-- Piece enclosures alone do not certify coverage of an unresolved block. -/
def allEmittedPiecesPass : Bool := blocks.all (fun b =>
  b.pieces.all (piecePass (cell b.cellIndex) b.blockIndex))

