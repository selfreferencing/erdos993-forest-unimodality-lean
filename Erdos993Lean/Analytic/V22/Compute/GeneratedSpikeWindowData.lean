def spikeCell (index : Nat) : V22SpikeCell :=
  spikeCells.getD index ⟨0, 0, 0, 0, [], [], false⟩

def classFor (cell : V22SpikeCell) : Option V22Class :=
  classes.find? (fun c => c.classId == cell.classId)

def neededBlocks (index : Nat) : List Nat :=
  (GeneratedRayData.blocks.filter (fun b => b.cellIndex == index && b.status == 1)).map (·.blockIndex)

def markedIndices : List Nat := (List.range 44).filter (fun i => (spikeCell i).window)

def markedPass (d : MarkedCell) : Bool :=
  let cell := spikeCell d.cellIndex
  decide (d.cellIndex < 44 ∧ d.blockIndices = neededBlocks d.cellIndex) && cell.window &&
  match classFor cell with
  | none => false
  | some c => startPass c cell d.startPieces && d.blockIndices.all (fun i =>
      decide (i < 5) && cellPass c cell (cell.logBounds.getD i 0) d.price)

def check : Bool := decide (data.length = 14 ∧ data.map (·.cellIndex) = markedIndices) && data.all markedPass

def fallbackBlockCount : Nat := (data.map (fun d => d.blockIndices.length)).sum

