import Init

/-!
# Exact rational data for the repaired V22 finite checks

Generated by `scripts/lean_v22_data.py`; nominal decimal endpoints are exact
rationals. Spike bounds are the upward-rounded Table 4 values. A window-marked
spike cell carries the bound for `min(Phi, Def_g)`, not for `Phi` alone.
This module contains data only, with no finite-check proof or promotion verdict.
Existing 55-row theta, D, ell0 and activity tables are reused through V21.Pieces
and MGF.Pieces by consumers; they are deliberately not duplicated here.
-/

namespace Erdos993Lean.Analytic.V22

structure V22Class where
  classId : Nat
  name : String
  ra : Rat
  rb : Rat
  b : Rat
  beta : Rat
  tau : Rat
  thi : Rat
  muD : Rat
  iotas : List Nat
  deriving Repr

structure V22WingClass where
  classId : Nat
  name : String
  ra : Rat
  rb : Rat
  tau : Rat
  muW : Rat
  iotas : List Nat
  edges : List Rat
  deriving Repr

structure V22SpikeCell where
  classId : Nat
  lo : Rat
  hi : Rat
  ma : Rat
  bounds : List Rat
  logBounds : List Rat
  window : Bool
  deriving Repr

structure V22Cell where
  classId : Nat
  lo : Rat
  hi : Rat
  deriving Repr

private def q (n : Int) (d : Nat) : Rat := mkRat n d


